# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Required: API key from https://resend.com/api-keys
RESEND_API_KEY=re_DgZnsahV_4MyXaFB4iUoa3WscHLq17FvD

# Optional: where enquiries are delivered. Defaults to the email in lib/site.ts.
CONTACT_TO_EMAIL=avcorp86@gmail.com

# Optional: the "from" address enquiry emails are sent from.
# Until a domain is verified in Resend (https://resend.com/domains), sending
# only works from their shared onboarding@resend.dev address.
# Once your domain (e.g. avcorp.co.in) is verified, switch this to an address
# on that domain, e.g. "A V CORP Website <enquiries@avcorp.co.in>".
CONTACT_FROM_EMAIL="A V CORP Website <onboarding@resend.dev>"

# Production domain used for canonical URLs, sitemap, robots.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.avcorp.co.in
